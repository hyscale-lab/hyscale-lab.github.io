---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  /** Header floats over a dark hero instead of sitting on the page background. */
  overlayHeader?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const s = site();
const {
  title,
  description = s.description,
  overlayHeader = false,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} | ${s.name}` : `${s.name} | ${s.institution}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {s.google_site_verification && <meta name="google-site-verification" content={s.google_site_verification} />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${s.name} blog`} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0d2b" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Theme: light unless the visitor picked dark. Runs before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const apply = () => {
          let t = null;
          try {
            t = localStorage.getItem('theme');
          } catch {}
          const root = document.documentElement;
          root.classList.toggle('dark', t === 'dark');
          root.classList.remove('no-js');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-brand px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade sections in as they scroll into view (.reveal → .is-visible).
      const reveal = () => {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('is-visible'));
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>

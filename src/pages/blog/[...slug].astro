---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { tagIndex, site } from '../../lib/data';
import { getPosts, formatDate, readingTime } from '../../lib/blog';
import { getPerson } from '../../lib/people';

export async function getStaticPaths() {
  // Drafts are built (reachable by link) but not listed anywhere.
  const posts = await getPosts({ drafts: true });
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tags = tagIndex();
const authors = post.data.authors.map((a) => getPerson(a)!);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const s = site();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updated && { dateModified: post.data.updated.toISOString() }),
  author: authors.map((a) => ({ '@type': 'Person', name: a.name, url: a.links?.website })),
  publisher: { '@type': 'Organization', name: s.full_name, url: s.url },
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  overlayHeader
  ogType="article"
  noindex={post.data.draft}
  jsonLd={jsonLd}
>
  <header class="night-band">
    <div class="container-x max-w-4xl pt-32 pb-14 sm:pt-36">
      <a href="/blog/" class="eyebrow inline-flex items-center gap-2 text-night-accent hover:text-white">
        ← Blog
      </a>
      {post.data.draft && (
        <p class="mt-4 inline-block rounded bg-highlight px-2 py-0.5 text-xs font-semibold text-ink">
          Draft (not listed)
        </p>
      )}
      <h1 class="mt-4 text-4xl leading-tight font-bold tracking-tight sm:text-5xl">{post.data.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-night-muted">{post.data.description}</p>
      <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-night-muted">
        {authors.length > 0 && <span class="text-night-ink">{authors.map((a) => a.name).join(', ')}</span>}
        <span class="inline-flex items-center gap-1.5">
          <Icon name="calendar" class="size-4" />
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="clock" class="size-4" />
          {readingTime(post.body)} min read
        </span>
        {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
      </p>
    </div>
  </header>

  <div class="container-x grid max-w-6xl gap-12 py-14 lg:grid-cols-[1fr_14rem]">
    <article class="prose-lab min-w-0 lg:order-1">
      <Content />
    </article>
    <aside class="lg:order-2">
      <div class="grid gap-8 lg:sticky lg:top-24">
        {toc.length > 1 && (
          <nav aria-label="On this page">
            <p class="eyebrow mb-3 text-muted">On this page</p>
            <ul class="grid gap-2 text-sm">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 && 'pl-3']}>
                  <a href={`#${h.slug}`} class="text-muted hover:text-brand">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {post.data.tags.length > 0 && (
          <div>
            <p class="eyebrow mb-3 text-muted">Tags</p>
            <ul class="flex flex-wrap gap-2">
              {post.data.tags.map((t) => (
                <li>
                  <a href={`/blog/?tag=${t}`} class="chip">
                    {tags.label(t)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import SplitSection from '../components/sections/SplitSection.astro';
import StatsBar from '../components/sections/StatsBar.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import NewsList from '../components/sections/NewsList.astro';
import LogoCarousel from '../components/sections/LogoCarousel.astro';
import CTA from '../components/sections/CTA.astro';
import PubList from '../components/pubs/PubList.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/data';
import { getPapers, totalCitations } from '../lib/papers';
import { currentGroups } from '../lib/people';
import { totalStars } from '../lib/github';
import { getPillars, getProjects, projectUrl } from '../lib/research';
import { getPosts } from '../lib/blog';
import heroImage from '../../content/gallery/lab_2025-07-21.jpeg';
import teamImage from '../../content/gallery/lab_2025-07-13.jpeg';
import vhiveImage from '../../content/projects/images/vhive-header.jpg';

const s = site();
const papers = getPapers();
const selected = papers.filter((p) => p.selected).slice(0, 4);
const members = currentGroups().reduce((n, g) => n + g.members.length, 0) + 1; // + PI
const pillars = await getPillars();
const projects = await getProjects();
const vhive = projects.find((p) => p.id === 'vhive');
const stars = await totalStars(projects.map((p) => p.data.repo));
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n));
const stats = [
  { value: String(papers.length), label: 'Publications' },
  { value: `${fmt(totalCitations())}+`, label: 'Google Scholar citations' },
  { value: String(members), label: 'Lab members' },
  ...(stars !== null ? [{ value: `${fmt(stars)}+`, label: 'GitHub stars on our open source' }] : []),
];
const posts = (await getPosts()).slice(0, 3);
---

<Base overlayHeader>
  <Hero
    eyebrow={s.hero.eyebrow}
    title={s.hero.title}
    subtitle={s.hero.subtitle}
    image={heroImage}
    primary={{ label: 'Explore our research', href: '/research/' }}
    secondary={{ label: 'Join the lab', href: '/join/' }}
  />

  <FeatureGrid
    id="research"
    eyebrow="Research pillars"
    title="Three directions, one goal: efficient cloud systems."
    lead={s.description}
    features={pillars.map((p) => ({
      icon: p.data.icon,
      title: p.data.title,
      summary: p.data.summary,
      href: `/research/${p.id}/`,
      meta:
        projects
          .filter((x) => x.data.pillar === p.id)
          .map((x) => x.data.title)
          .join(' · ') || 'Learn more',
    }))}
  />

  <StatsBar stats={stats} />

  <SplitSection
    eyebrow="Open-source systems"
    title="vHive: the serverless research platform used by 30+ universities"
    image={vhiveImage}
    imageAlt="vHive logo: open-source framework for serverless experimentation"
    imageClass="bg-white p-8"
    dark
  >
    <p>
      vHive is our full-stack open-source environment for representative serverless experimentation across the
      distributed hardware/software stack. It integrates production-grade components including AWS Firecracker,
      containerd and Kubernetes.
    </p>
    <p>Its ASPLOS 2021 paper received the Distinguished Artifact Award.</p>
    <Fragment slot="actions">
      <a href={vhive ? projectUrl(vhive) : '/research/serverless/'} class="btn-primary">
        About vHive <Icon name="arrow-right" class="size-4" />
      </a>
      <a href="https://github.com/vhive-serverless/vhive" class="btn-ghost text-white">
        <Icon name="github" class="size-4" /> GitHub
      </a>
    </Fragment>
  </SplitSection>

  <section class="py-24 sm:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Selected publications" title="Recent highlights">
        <a href="/publications/" class="mt-6 inline-flex items-center gap-2 font-semibold text-brand hover:gap-3">
          All {papers.length} publications <Icon name="arrow-right" class="size-4" />
        </a>
      </SectionHeading>
      <div class="reveal">
        <PubList papers={selected} previews={false} showTags={false} />
      </div>
    </div>
  </section>

  <NewsList />

  <SplitSection
    eyebrow="People"
    title="A team across systems, architecture and AI"
    image={teamImage}
    imageAlt="HyScale Lab group photo at Nanyang Technological University"
    flip
  >
    <p>
      Postdocs, PhD students, research assistants, interns and undergraduate researchers from around the world work
      together on open problems in cloud systems.
    </p>
    <Fragment slot="actions">
      <a href="/people/" class="btn-primary">
        Meet the team <Icon name="arrow-right" class="size-4" />
      </a>
      <a href="/lab-life/" class="btn-ghost text-ink">
        Lab life
      </a>
    </Fragment>
  </SplitSection>

  {posts.length > 0 && (
    <section class="py-24 sm:py-28">
      <div class="container-x">
        <SectionHeading eyebrow="From the blog" title="Latest posts" />
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <LogoCarousel />

  <CTA
    title="Build the next generation of cloud systems with us."
    text="We welcome enquiries from prospective PhD students, postdocs, interns and research assistants interested in serverless, agentic and multi-modal AI cloud systems."
    primary={{ label: 'Join us', href: '/join/' }}
    secondary={{ label: 'Contact the PI', href: `mailto:${s.contact.email}` }}
  />
</Base>

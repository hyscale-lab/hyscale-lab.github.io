---
import Base from '../layouts/Base.astro';
import { load } from '../lib/data';

const nf = load('page-headers.yaml').not_found;
---

<Base title="Page not found" noindex overlayHeader>
  <section class="night-band flex min-h-[80svh] items-center">
    <div class="container-x py-32 text-center">
      <p class="gradient-text text-8xl font-bold">404</p>
      <h1 class="mt-6 text-3xl font-bold tracking-tight">{nf.title}</h1>
      <p class="mt-4 text-night-muted">{nf.lead}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {nf.links.map((l, i) => (
          <a href={l.href} class:list={[i === 0 ? 'btn-primary' : 'btn-ghost text-white']}>
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

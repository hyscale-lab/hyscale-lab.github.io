---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PubList from '../components/pubs/PubList.astro';
import TagChips from '../components/TagChips.astro';
import Icon from '../components/Icon.astro';
import { getPapers, totalCitations } from '../lib/papers';
import { getPeople } from '../lib/people';

const papers = getPapers();
const years = [...new Set(papers.map((p) => p.year))];
const authorIds = new Set(papers.flatMap((p) => p.authors.flatMap((a) => (a.member ? [a.member.id] : []))));
const authors = getPeople()
  .filter((p) => authorIds.has(p.id))
  .sort((a, b) => a.name.localeCompare(b.name));
// Structured data so search engines can read the paper list.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: papers.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'ScholarlyArticle',
      headline: p.title,
      author: p.authors.map((a) => ({ '@type': 'Person', name: a.name })),
      datePublished: String(p.year),
      ...(p.venue && { isPartOf: { '@type': 'PublicationEvent', name: p.venue } }),
      ...(p.links[0] && { url: new URL(p.links[0].href, Astro.site).href }),
    },
  })),
};
const field =
  'h-10 rounded-lg border border-line bg-raised px-3 text-sm text-ink focus:border-brand focus:outline-none';
---

<Base
  title="Publications"
  description="HyScale Lab publications across serverless, agentic, and multi-modal and embodied AI cloud systems."
  overlayHeader
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Research output"
    title="Publications"
    lead="Peer-reviewed papers and preprints from HyScale Lab and the PI's earlier work, generated from our BibTeX file."
  >
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 text-sm">
      <div>
        <dt class="text-night-muted">Papers</dt>
        <dd class="text-2xl font-semibold">{papers.length}</dd>
      </div>
      <div>
        <dt class="text-night-muted">Google Scholar citations</dt>
        <dd class="text-2xl font-semibold">{totalCitations().toLocaleString('en-US')}</dd>
      </div>
      <div>
        <dt class="text-night-muted">Years</dt>
        <dd class="text-2xl font-semibold">
          {years.at(-1)}–{years[0]}
        </dd>
      </div>
    </dl>
  </PageHeader>

  <div data-filter-root class="container-x scroll-mt-20 py-12">
    <div class="card mb-8 grid gap-4 p-4 sm:p-5">
      <div class="flex flex-wrap items-center gap-3">
        <label class="relative min-w-56 flex-1">
          <span class="sr-only">Search publications</span>
          <Icon name="search" class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted" />
          <input
            type="search"
            data-filter-q
            placeholder="Search title, author, venue…"
            class:list={[field, 'w-full pl-9']}
          />
        </label>
        <label>
          <span class="sr-only">Year</span>
          <select data-filter-year class={field}>
            <option value="">All years</option>
            {years.map((y) => (
              <option value={String(y)}>{y}</option>
            ))}
          </select>
        </label>
        <label>
          <span class="sr-only">Lab author</span>
          <select data-filter-author class={field}>
            <option value="">All lab authors</option>
            {authors.map((a) => (
              <option value={a.id}>{a.name}</option>
            ))}
          </select>
        </label>
      </div>
      <details class="group sm:open" open>
        <summary class="flex cursor-pointer list-none items-center gap-2 text-xs font-semibold text-muted">
          Topics <Icon name="chevron-down" class="size-3.5 transition group-open:rotate-180" />
        </summary>
        <div class="mt-3">
          <TagChips used={papers.flatMap((p) => p.tags)} />
        </div>
      </details>
      <p class="flex items-center gap-3 text-xs text-muted" aria-live="polite">
        <span>
          Showing{' '}
          <strong data-filter-count class="text-ink">
            {papers.length}
          </strong>{' '}
          papers
        </span>
        <button type="button" data-filter-clear hidden class="font-semibold text-brand hover:underline">
          Clear filters
        </button>
      </p>
    </div>

    <div class="grid gap-8">
      <PubList papers={papers} groupByYear />
    </div>
    <p data-filter-empty hidden class="py-16 text-center text-muted">
      No papers match these filters.
      <button type="button" data-filter-clear class="font-semibold text-brand hover:underline">
        Clear filters
      </button>
    </p>
  </div>
</Base>

<script>
  import { setupFilter } from '../scripts/filter';
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-filter-root]');
    if (root) setupFilter(root);
  });
</script>

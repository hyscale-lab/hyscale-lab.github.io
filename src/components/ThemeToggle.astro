---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-full border border-current/20 transition hover:border-current/50"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <Icon name="moon" class="size-4 dark:hidden" />
  <Icon name="sun" class="hidden size-4 dark:block" />
</button>

<script>
  const bind = () =>
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
      btn.onclick = () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
        document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(dark)));
      };
    });
  document.addEventListener('astro:page-load', bind);
</script>

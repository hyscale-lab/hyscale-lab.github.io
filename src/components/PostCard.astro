---
import { tagIndex } from '../lib/data';
import { formatDate, readingTime, type Post } from '../lib/blog';
import { getPerson } from '../lib/people';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const tags = tagIndex();
const authors = post.data.authors.map((a) => getPerson(a)?.name).filter(Boolean);
---

<article
  data-item
  data-tags={post.data.tags.join(' ')}
  data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}
  class="card reveal group relative flex flex-col p-6 transition hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl"
>
  <p class="text-xs font-medium text-muted">
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time> ·{' '}
    {readingTime(post.body)} min read
  </p>
  <h3 class="mt-3 text-xl leading-snug font-semibold tracking-tight">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-brand">
      {post.data.title}
    </a>
  </h3>
  <p class="mt-3 flex-1 leading-relaxed text-muted">{post.data.description}</p>
  {authors.length > 0 && <p class="mt-4 text-sm text-ink/80">{authors.join(', ')}</p>}
  {post.data.tags.length > 0 && (
    <ul class="relative z-10 mt-4 flex flex-wrap gap-1.5">
      {post.data.tags.map((t) => (
        <li>
          <a href={`/blog/?tag=${t}`} data-tag-link={t} class="text-xs text-muted hover:text-brand">
            #{tags.label(t)}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>

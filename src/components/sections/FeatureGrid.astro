---
// Research pillars as icon cards.
import Icon from '../Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Feature {
  icon: 'bolt' | 'sparkles' | 'eye';
  title: string;
  summary: string;
  href: string;
  meta?: string;
}
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  features: Feature[];
}
const { id, eyebrow, title, lead, features } = Astro.props;
---

<section id={id} class="scroll-mt-16 py-24 sm:py-28">
  <div class="container-x">
    <SectionHeading eyebrow={eyebrow} title={title} lead={lead} />
    <div class="grid gap-6 md:grid-cols-3">
      {features.map((f, i) => (
        <a
          href={f.href}
          class="card reveal group relative flex flex-col overflow-hidden p-7 transition hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl"
          style={`transition-delay: ${i * 80}ms`}
        >
          <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand via-grad-mid to-accent opacity-0 transition group-hover:opacity-100" />
          <span class="mb-6 grid size-12 place-items-center rounded-xl bg-brand-soft text-brand">
            <Icon name={f.icon} class="size-6" />
          </span>
          <h3 class="text-xl font-semibold tracking-tight">{f.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-muted">{f.summary}</p>
          <p class="mt-6 flex items-center justify-between text-sm font-semibold text-brand">
            <span>{f.meta ?? 'Learn more'}</span>
            <Icon name="arrow-right" class="size-4 transition group-hover:translate-x-1" />
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

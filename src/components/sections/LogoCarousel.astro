---
// "Collaboration & Funding": an auto-scrolling strip of partner logos on white
// tiles (many logos have opaque white backgrounds). Grey until hovered.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from './SectionHeading.astro';
import { load } from '../../lib/data';

const partners = load('partners.yaml');
const files = import.meta.glob<{ default: ImageMetadata }>('/content/partners/*.{png,jpg,jpeg,webp,svg}', {
  eager: true,
});
const resolved = partners.map((p) => {
  const img = files[`/content/partners/${p.logo}`]?.default;
  if (!img) throw new Error(`[content] content/partners.yaml: logo "${p.logo}" not found in content/partners/`);
  return { ...p, img };
});
const groups = [
  { type: 'sponsor', label: 'Sponsors' },
  { type: 'collaborator', label: 'Collaborators' },
]
  .map((g) => ({ ...g, items: resolved.filter((p) => p.type === g.type) }))
  .filter((g) => g.items.length);
---

{resolved.length > 0 && (
  <section class="overflow-hidden bg-surface py-24 sm:py-28">
    <div class="container-x">
      <SectionHeading
        eyebrow="Collaboration & Funding"
        title="Working with industry and academia"
        lead="We thank our past and present collaborators around the globe for their professional and financial support."
        align="center"
      />
    </div>
    <div class="grid gap-8">
      {groups.map((g) => (
        <div>
          {groups.length > 1 && <p class="eyebrow mb-4 text-center text-muted">{g.label}</p>}
          <div class="group relative [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
            <ul class="flex w-max animate-marquee gap-5 group-hover:[animation-play-state:paused] motion-reduce:w-full motion-reduce:animate-none motion-reduce:flex-wrap motion-reduce:justify-center">
              {[...g.items, ...g.items].map((p, i) => (
                <li
                  aria-hidden={i >= g.items.length ? 'true' : undefined}
                  class={i >= g.items.length ? 'motion-reduce:hidden' : ''}
                >
                  <a
                    href={p.url}
                    tabindex={i >= g.items.length ? -1 : undefined}
                    class="grid h-24 w-48 place-items-center rounded-2xl border border-line bg-white px-6 shadow-sm grayscale transition hover:-translate-y-0.5 hover:shadow-lg hover:grayscale-0"
                    title={p.name}
                  >
                    <Image src={p.img} alt={p.name} height={96} class="max-h-12 w-auto object-contain" loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

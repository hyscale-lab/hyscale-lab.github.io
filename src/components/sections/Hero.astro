---
// Full-screen hero: photo behind a dark gradient overlay, with a gentle
// parallax on large screens with a mouse.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { eyebrow, title, subtitle, image, primary, secondary } = Astro.props;
// Highlight the last two words of the title with the gradient.
const words = title.split(' ');
const head = words.slice(0, -2).join(' ');
const tail = words.slice(-2).join(' ');
---

<section class="night-band relative flex min-h-[100svh] items-center">
  <div data-parallax class="absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <!-- Phones get a ~640px image instead of the full 1920px one. Under a dark overlay, low quality is invisible. -->
    <Image
      src={image}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={55}
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-night/85 via-night/75 to-night" aria-hidden="true"></div>

  <div class="container-x pt-28 pb-24">
    <p class="eyebrow mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-night-accent-soft backdrop-blur">
      <span class="size-1.5 rounded-full bg-accent"></span>
      {eyebrow}
    </p>
    <h1 class="max-w-4xl text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl lg:text-7xl">
      {head} <span class="gradient-text">{tail}</span>
    </h1>
    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-night-muted sm:text-xl">{subtitle}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={primary.href} class="btn-primary">
        {primary.label} <Icon name="arrow-right" class="size-4" />
      </a>
      {secondary && (
        <a href={secondary.href} class="btn-ghost text-white">
          {secondary.label}
        </a>
      )}
    </div>
    <slot />
  </div>

  <a
    href="#research"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 animate-bounce text-night-muted hover:text-white sm:block"
    aria-label="Scroll to research"
  >
    <Icon name="chevron-down" class="size-6" />
  </a>
</section>

<script>
  // Gentle parallax on the hero photo. Only on large screens with a mouse: on
  // phones and low-end devices a scroll-linked transform costs frames for
  // little effect. Also skipped when the visitor prefers reduced motion.
  const setup = () => {
    const el = document.querySelector<HTMLElement>('[data-parallax]');
    const ok = matchMedia('(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    if (!el || !ok.matches) return;
    el.style.willChange = 'transform';
    let raf = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(
        () => (el.style.transform = `translate3d(0, ${window.scrollY * 0.35}px, 0) scale(1.1)`),
      );
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), {
      once: true,
    });
  };
  document.addEventListener('astro:page-load', setup);
</script>

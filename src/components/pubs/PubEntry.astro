---
// One publication in al-folio style: venue badge (+ preview) on the left;
// title, authors, venue and Abs / Bib / PDF / Code buttons on the right.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import type { Paper } from '../../lib/papers';
import { tagIndex } from '../../lib/data';

interface Props {
  paper: Paper;
  /** Show the preview thumbnail column. */
  previews?: boolean;
  /** Show tag chips under the entry. */
  showTags?: boolean;
}

const { paper: p, previews = true, showTags = true } = Astro.props;
const tags = tagIndex();

const images = import.meta.glob<{ default: ImageMetadata }>('/content/papers/previews/*.{png,jpg,jpeg,webp,gif}', {
  eager: true,
});
const preview = p.preview ? images[`/content/papers/previews/${p.preview}`]?.default : undefined;
const id = `pub-${p.key}`;
const searchText = [p.title, p.venue, p.abbr, p.year, ...p.authors.map((a) => a.name), ...p.tags.map(tags.label)]
  .join(' ')
  .toLowerCase();
const LINK_ICONS: Record<string, Parameters<typeof Icon>[0]['name']> = {
  PDF: 'file',
  arXiv: 'file',
  Code: 'code',
  Video: 'play',
  Slides: 'file',
  Website: 'globe',
  DOI: 'link',
  URL: 'link',
};
const btn =
  'inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-xs font-semibold text-muted transition hover:border-brand hover:text-brand aria-expanded:border-brand aria-expanded:bg-brand-soft aria-expanded:text-brand';
---

<li
  id={id}
  data-item
  data-year={p.year}
  data-tags={p.tags.join(' ')}
  data-authors={p.authors.flatMap((a) => (a.member ? [a.member.id] : [])).join(' ')}
  data-search={searchText}
  class="group grid gap-4 py-6 sm:grid-cols-[9.5rem_1fr] sm:gap-6"
>
  <div class="flex flex-row items-start gap-3 sm:flex-col">
    {p.abbr && (
      <a
        href={p.venueUrl ?? undefined}
        class="inline-flex min-w-20 justify-center rounded-md px-2.5 py-1 text-xs font-bold tracking-wide text-white shadow-sm"
        style={`background-color: ${p.venueColor}`}
        title={p.venue}
      >
        {p.abbr}
      </a>
    )}
    {previews && preview && (
      <Image
        src={preview}
        alt=""
        width={300}
        class="hidden w-full rounded-lg border border-line bg-white object-cover sm:block"
        loading="lazy"
      />
    )}
  </div>

  <div class="min-w-0">
    <h3 class="text-[1.05rem] leading-snug font-semibold text-ink">{p.title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-muted">
      {p.authors.map((a, i) => (
        <>
          {a.member ? (
            <a
              href={`/publications/?author=${a.member.id}`}
              class="font-semibold text-ink underline decoration-accent/40 decoration-2 underline-offset-[3px] hover:decoration-accent"
              data-author-link={a.member.id}
            >
              {a.name}
            </a>
          ) : (
            <span>{a.name}</span>
          )}
          {i < p.authors.length - 2 ? ', ' : i === p.authors.length - 2 ? ', and ' : ''}
        </>
      ))}
    </p>
    <p class="mt-1 text-sm text-muted">
      <em>{p.venue}</em>
      {p.venue && ', '}
      {p.year}
      {p.note && <span class="text-ink/80"> · {p.note}</span>}
    </p>

    {p.award && (
      <p class="mt-2 inline-flex items-center gap-1.5 rounded-md bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent">
        <Icon name="award" class="size-3.5" />
        {p.award}
      </p>
    )}

    <div class="mt-3 flex flex-wrap items-center gap-2">
      {p.abstract && (
        <button type="button" class={btn} aria-expanded="false" aria-controls={`${id}-abs`} data-toggle>
          Abs
        </button>
      )}
      <button type="button" class={btn} aria-expanded="false" aria-controls={`${id}-bib`} data-toggle>
        Bib
      </button>
      {p.links.map((l) => (
        <a href={l.href} class={btn}>
          <Icon name={LINK_ICONS[l.label] ?? 'link'} class="size-3.5" />
          {l.label}
        </a>
      ))}
      {p.citations !== null && p.citations > 0 && (
        <span
          class="inline-flex items-center gap-1 rounded-md bg-surface px-2.5 py-1 text-xs font-medium text-muted"
          title="Citations on Google Scholar"
        >
          <Icon name="quote" class="size-3.5" />
          {p.citations} citations
        </span>
      )}
    </div>

    {showTags && p.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
        {p.tags.map((t) => (
          <li>
            <a href={`/publications/?tag=${t}`} class="text-xs text-muted hover:text-brand" data-tag-link={t}>
              #{tags.label(t)}
            </a>
          </li>
        ))}
      </ul>
    )}

    {p.abstract && (
      <div id={`${id}-abs`} hidden class="mt-3 rounded-lg border border-line bg-surface p-4 text-sm leading-relaxed">
        {p.abstract}
      </div>
    )}
    <div id={`${id}-bib`} hidden class="relative mt-3">
      <pre class="overflow-x-auto rounded-lg border border-line bg-surface p-4 font-mono text-xs leading-relaxed"><code>{p.bibtex}</code></pre>
      <button
        type="button"
        data-copy={p.bibtex}
        class="absolute top-2 right-2 inline-flex items-center gap-1 rounded-md border border-line bg-raised px-2 py-1 text-xs font-medium text-muted hover:text-ink"
      >
        <Icon name="copy" class="size-3.5" />
        <span>Copy</span>
      </button>
    </div>
  </div>
</li>
